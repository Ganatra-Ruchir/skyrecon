# ── SkyRecon configuration ───────────────────────────────────────────────
# Generate secrets with:  python -m app.cli genkeys
SKYRECON_ENV=production

# 32-byte URL-safe base64 master key. Encrypts every sensitive DB field.
# LOSING THIS KEY MAKES ENCRYPTED DATA UNRECOVERABLE. Back it up in a vault.
SKYRECON_MASTER_KEY=

# Signing key for access/refresh tokens (min 32 chars).
SKYRECON_JWT_SECRET=

# Comma-separated origins allowed to call the API.
SKYRECON_CORS_ORIGINS=http://localhost:8000

# sqlite:///./skyrecon.db  |  postgresql+psycopg://user:pass@host/db
# (PostgreSQL also needs: pip install -r requirements-postgres.txt)
SKYRECON_DATABASE_URL=sqlite:///./skyrecon.db

# First-run administrator. Change the password immediately after first login.
SKYRECON_BOOTSTRAP_EMAIL=admin@skyrecon.local
SKYRECON_BOOTSTRAP_PASSWORD=

# Token lifetimes
SKYRECON_ACCESS_TTL_MIN=15
SKYRECON_REFRESH_TTL_DAYS=7

# Rate limiting (requests / window seconds) applied per client identity
SKYRECON_RATE_LIMIT=120
SKYRECON_RATE_WINDOW=60

# Require TOTP for every account with the admin role
SKYRECON_REQUIRE_ADMIN_MFA=true

# Confidence half-life in days: how fast an unseen indicator fades
SKYRECON_IOC_HALF_LIFE_DAYS=30
