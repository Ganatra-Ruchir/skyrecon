{
  "version": 2,
  "builds": [
    {
      "src": "console/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app/static/assessment*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assessment/(.*)",
      "dest": "/app/static/$1"
    },
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/console/index.html"
    }
  ]
}